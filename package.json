{
  "name": "facturo",
  "version": "0.1.0",
  "private": true,
  "description": "Facturo \u2014 e-Factura invoicing for Moldovan small and medium business",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "lint:fsd": "steiger ./src",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"messages/*.json\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"messages/*.json\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "api:generate": "rtk-query-codegen-openapi openapi-codegen.config.ts",
    "verify": "npm run format:check && npm run lint && npm run lint:fsd && npm run check:i18n && npm run typecheck && npm run test && npm run build",
    "check:i18n": "node scripts/check-i18n.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@reduxjs/toolkit": "^2.12.0",
    "@sentry/nextjs": "^10.74.0",
    "framer-motion": "^13.2.0",
    "next": "^16.3.5",
    "next-intl": "^4.14.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "react-redux": "^9.3.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@feature-sliced/steiger-plugin": "^0.7.0",
    "@rtk-query/codegen-openapi": "^2.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^7.2.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.9.6",
    "steiger": "^0.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "license": "UNLICENSED"
}
