# Base url of facturo-server. Server-side fetches use this directly; the browser
# goes through the Next.js rewrite so cookies stay first-party.
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Canonical origin, used by sitemap, robots, hreflang and Open Graph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Empty DSN is valid: the app behaves identically, just without reporting.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# Google Cloud: Web application client ID (same as backend GOOGLE_CLIENT_ID).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
