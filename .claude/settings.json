{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx eslint:*)",
      "Bash(npx prettier:*)",
      "Bash(npx steiger:*)",
      "Bash(npx vitest:*)",
      "Bash(node scripts/check-i18n.mjs)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(rg:*)",
      "Bash(ls:*)",
      "Read(//home/user/facturo-/**)"
    ],
    "deny": ["Read(./.env)", "Read(./.env.*)", "Edit(./src/shared/api/generated/**)"]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-brief.sh" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit-check.sh" },
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/i18n-parity.sh" }
        ]
      }
    ]
  }
}
